[ODBC Data Sources]
data_source_name = desodbc@CONNECTOR_DRIVER_TYPE_SHORT1@
data_source_name = desodbc@CONNECTOR_DRIVER_TYPE_SHORT2@

[desodbc@CONNECTOR_DRIVER_TYPE_SHORT1@]
Driver          = @TEST_DRIVER1@
DESCRIPTION     = @DESCRIPTION1@
DES_EXEC        = @TEST_DES_EXEC@
DES_WORKING_DIR = @TEST_DES_WORKING_DIR@
@TEST_OPTIONS@

[desodbc@CONNECTOR_DRIVER_TYPE_SHORT2@]
Driver          = @TEST_DRIVER2@
DESCRIPTION     = @DESCRIPTION2@
DES_EXEC        = @TEST_DES_EXEC@
DES_WORKING_DIR = @TEST_DES_WORKING_DIR@
@TEST_OPTIONS@
